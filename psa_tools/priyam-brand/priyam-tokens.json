{
  "$name": "Priyam Sales Agency — Design Tokens",
  "$version": "1.0.0",
  "color": {
    "brand": {
      "gold": "#FBAE1A",
      "terracotta": "#DF6D35",
      "ledgerSlate": "#515162"
    },
    "neutral": {
      "ink": "#2B2B33",
      "slate": "#515162",
      "body": "#6B6B78",
      "muted": "#9A9AA6",
      "border": "#ECE8E1",
      "cloud": "#F3F0EB",
      "paper": "#FBFAF8",
      "white": "#FFFFFF"
    },
    "status": {
      "confirmed": "#2E8B6F",
      "pending": "#FBAE1A",
      "issue": "#D0473B"
    },
    "gradient": "linear-gradient(140deg, #FBAE1A, #DF6D35)"
  },
  "font": {
    "display": "'Outfit', sans-serif",
    "body": "'Hanken Grotesk', sans-serif",
    "mono": "'IBM Plex Mono', monospace",
    "hindi": "'Noto Sans Devanagari', sans-serif"
  },
  "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
  "type": {
    "display": { "size": "64px", "lineHeight": 1, "weight": 800, "tracking": "-0.02em", "font": "display" },
    "h1": { "size": "40px", "lineHeight": 1.05, "weight": 700, "tracking": "-0.02em", "font": "display" },
    "h2": { "size": "24px", "lineHeight": 1.25, "weight": 600, "tracking": "-0.01em", "font": "display" },
    "h3": { "size": "19px", "lineHeight": 1.3, "weight": 600, "font": "display" },
    "body": { "size": "17px", "lineHeight": 1.6, "weight": 400, "font": "body" },
    "small": { "size": "14.5px", "lineHeight": 1.6, "weight": 400, "font": "body" },
    "label": { "size": "12px", "tracking": "0.14em", "transform": "uppercase", "font": "mono" }
  },
  "radius": { "sm": "8px", "base": "14px", "lg": "16px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "shadow": {
    "sm": "0 1px 2px rgba(43,43,51,0.06)",
    "base": "0 18px 40px rgba(43,43,51,0.08)",
    "dark": "0 18px 40px rgba(43,43,51,0.22)"
  },
  "motion": { "ease": "cubic-bezier(.4,0,.2,1)", "duration": "180ms" }
}
